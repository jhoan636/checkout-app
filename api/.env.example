# Copy to .env and fill in the values. Never commit .env.

# HTTP
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=checkout
DB_PASSWORD=change-me
DB_NAME=checkout
DB_SSL=false

# Payment gateway (sandbox). Server-side only: never expose these to the browser.
GATEWAY_BASE_URL=https://sandbox.payment-gateway.example/v1
GATEWAY_PRIVATE_KEY=change-me
GATEWAY_INTEGRITY_SECRET=change-me
GATEWAY_TIMEOUT_MS=10000
